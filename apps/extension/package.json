{
  "name": "@mdbase-reader/extension",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm manifest:mdbase && vite build",
    "icons": "node scripts/write-icons.mjs",
    "package": "MDBASE_ENV=${MDBASE_ENV:-production} pnpm build && MDBASE_ENV=${MDBASE_ENV:-production} node scripts/package-extension.mjs",
    "manifest:mdbase": "node scripts/write-mdbase-manifest.mjs",
    "test": "pnpm manifest:mdbase && vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@mdbase-dev/sdk": "0.1.0-beta.187",
    "@mdbase-dev/sdk-lab": "file:../../packages/connect/vendor/sdk-493d29ca-lab-beta157.tgz",
    "@mdbase-dev/sdk-staging": "file:../../packages/connect/vendor/sdk-493d29ca-staging-beta157.tgz",
    "@lingui/core": "6.10.1",
    "@lingui/react": "6.10.1",
    "@mdbase-dev/i18n": "0.1.0-beta.149",
    "@mdbase-reader/i18n": "workspace:*",
    "@mdbase-dev/ui": "0.1.0-beta.149",
    "@mdbase-reader/connect": "workspace:*",
    "@mdbase-reader/core": "workspace:*",
    "@mdbase-reader/platform": "workspace:*",
    "@mdbase-reader/ui": "workspace:*",
    "@mdbase-reader/web-capture": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "latest",
    "vite": "latest"
  }
}
