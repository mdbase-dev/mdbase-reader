{
  "name": "@mdbase-reader/extension",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm manifest:mdbase && vite build",
    "icons": "node scripts/write-icons.mjs",
    "package": "MDBASE_ENV=${MDBASE_ENV:-production} pnpm build && MDBASE_ENV=${MDBASE_ENV:-production} node scripts/package-extension.mjs",
    "manifest:mdbase": "node scripts/write-mdbase-manifest.mjs",
    "test": "pnpm manifest:mdbase && vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@mdbase-dev/sdk": "file:../../packages/connect/vendor/sdk-e55d99c0-production-beta141.tgz",
    "@mdbase-dev/sdk-lab": "file:../../packages/connect/vendor/sdk-dev-eaa4e697-lab.tgz",
    "@mdbase-dev/sdk-staging": "file:../../packages/connect/vendor/sdk-dev-eaa4e697-staging.tgz",
    "@mdbase-dev/ui": "file:../../vendor/mdbase-dev-ui-dev-b2d7c464.tgz",
    "@mdbase-reader/connect": "workspace:*",
    "@mdbase-reader/core": "workspace:*",
    "@mdbase-reader/platform": "workspace:*",
    "@mdbase-reader/ui": "workspace:*",
    "@mdbase-reader/web-capture": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "latest",
    "vite": "latest"
  }
}
