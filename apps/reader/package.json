{
  "name": "@mdbase-reader/app",
  "version": "0.1.0-beta.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm manifest && pnpm manifest:validate && vite build",
    "deploy:dev": "node scripts/deploy-pages.mjs",
    "deploy:prod": "MDBASE_READER_DEPLOY_TARGET=production node scripts/deploy-pages.mjs",
    "dev": "pnpm manifest && vite --host 127.0.0.1",
    "manifest": "node scripts/write-manifest.mjs",
    "manifest:validate": "mdbase-connect-dev validate-manifest public/.well-known/mdbase-app.json",
    "manifest:verify": "node scripts/verify-manifest.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "pnpm manifest && pnpm manifest:verify && vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@citation-js/plugin-csl": "0.8.2",
    "@mdbase-reader/connect": "workspace:*",
    "@mdbase-reader/core": "workspace:*",
    "@mdbase-reader/markdown-editor": "workspace:*",
    "@mdbase-reader/platform": "workspace:*",
    "@mdbase-reader/reading-surface": "workspace:*",
    "@mdbase-reader/renderer-epub": "workspace:*",
    "@mdbase-reader/renderer-html": "workspace:*",
    "@mdbase-reader/renderer-pdf": "workspace:*",
    "@mdbase-reader/ui": "workspace:*",
    "@zip.js/zip.js": "^2.8.36",
    "citeproc": "2.4.63",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "latest",
    "vite": "latest"
  }
}
