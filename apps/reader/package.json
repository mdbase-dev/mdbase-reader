{
  "name": "@mdbase-reader/app",
  "version": "0.1.0-beta.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/write-pwa-icons.mjs",
    "build": "node scripts/package-zotero.mjs && pnpm manifest && pnpm manifest:validate && vite build",
    "build:lab": "VITE_MDBASE_ENV=lab MDBASE_READER_ORIGIN=https://lab.mdbase-reader.pages.dev pnpm build",
    "deploy:dev": "node scripts/deploy-pages.mjs",
    "deploy:prod": "MDBASE_READER_DEPLOY_TARGET=production node scripts/deploy-pages.mjs",
    "dev": "VITE_MDBASE_ENV=lab MDBASE_READER_ORIGIN=http://127.0.0.1:5173 pnpm dev:lab",
    "dev:lab": "node scripts/package-zotero.mjs && pnpm manifest && pnpm manifest:validate --allow-local && vite --host 127.0.0.1 --port 5173 --strictPort",
    "manifest": "node scripts/write-manifest.mjs",
    "manifest:validate": "node scripts/validate-manifest.mjs public/.well-known/mdbase-app.json",
    "manifest:verify": "node scripts/verify-manifest.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "pnpm manifest && pnpm manifest:verify && node --test scripts/*.test.mjs && vitest run src capture --maxWorkers=2 --testTimeout=15000",
    "test:browser": "node scripts/audit-reader.mjs",
    "test:feedback": "node scripts/feedback-browser-test.mjs",
    "test:pdf-touch": "node scripts/run-pdf-touch-audits.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:a11y": "node scripts/audit-accessibility.mjs"
  },
  "dependencies": {
    "@citation-js/plugin-csl": "0.8.2",
    "@lingui/core": "6.9.0",
    "@lingui/react": "6.9.0",
    "@mdbase-dev/sdk": "file:../../packages/connect/vendor/sdk-eaa4e697-production-beta141.tgz",
    "@mdbase-dev/sdk-legacy-729b5391": "file:../../vendor/mdbase-dev-sdk-0.0.0-729b5391.tgz",
    "@mdbase-dev/ui": "file:../../vendor/mdbase-dev-ui-dev-b2d7c464.tgz",
    "@mdbase-reader/connect": "workspace:*",
    "@mdbase-reader/core": "workspace:*",
    "@mdbase-reader/markdown-editor": "workspace:*",
    "@mdbase-reader/migration": "workspace:*",
    "@mdbase-reader/platform": "workspace:*",
    "@mdbase-reader/reading-surface": "workspace:*",
    "@mdbase-reader/renderer-epub": "workspace:*",
    "@mdbase-reader/renderer-html": "workspace:*",
    "@mdbase-reader/renderer-pdf": "workspace:*",
    "@mdbase-reader/ui": "workspace:*",
    "@mdbase-reader/web-capture": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@zip.js/zip.js": "^2.8.36",
    "citeproc": "2.4.63",
    "dockview-react": "8.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "latest",
    "axe-core": "^4.13.0",
    "fake-indexeddb": "6.2.4",
    "vite": "latest"
  }
}
